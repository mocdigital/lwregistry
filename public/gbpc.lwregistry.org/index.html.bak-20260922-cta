  </div>
  <div class="scrolldown">Scroll</div>
</section>

<!-- ===== STATS ===== -->
<div class="stats reveal">
  <div class="container">
    <div class="st"><div class="n">120+</div><div class="l">Nations Represented</div></div>
    <div class="st"><div class="n">15,000+</div><div class="l">Kingdom Businesses</div></div>
  </div>
</div>

<!-- ===== ABOUT ===== -->
<section id="about">
  <div class="container about-grid">
    <div class="about-text reveal">
      <div class="eyebrow" style="color:var(--gold);">About GBPC</div>
      <h2 style="color:var(--navy2);font-size:30px;margin:10px 0 18px;">Where Kingdom Business Meets Prayer</h2>
