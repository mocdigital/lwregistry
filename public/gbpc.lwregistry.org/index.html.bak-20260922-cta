<script>
  // scroll reveal
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('visible'); } });
  }, {threshold:0.15});
  revealEls.forEach(el=>io.observe(el));

  // background dots in hero
  const dotsEl = document.getElementById('dots');
  for(let i=0;i<28;i++){
    const d = document.createElement('span');
    d.style.left = Math.random()*100+'%';
    d.style.top = Math.random()*100+'%';
    d.style.opacity = (0.2 + Math.random()*0.5).toFixed(2);
    dotsEl.appendChild(d);
  }

  // countdown to the conference date (edit as needed)
  const target = new Date(2026, 8, 22, 9, 0, 0, 0); // 22 Sep 2026, 09:00 — conference date
  function tick(){
    const now = new Date();
    let diff = Math.max(0, target - now);
    const days = Math.floor(diff/(1000*60*60*24));
    const hours = Math.floor((diff/(1000*60*60))%24);
    const mins = Math.floor((diff/(1000*60))%60);
    const secs = Math.floor((diff/1000)%60);
    document.getElementById('cd-days').textContent = String(days).padStart(2,'0');
    document.getElementById('cd-hours').textContent = String(hours).padStart(2,'0');
    document.getElementById('cd-mins').textContent = String(mins).padStart(2,'0');
    document.getElementById('cd-secs').textContent = String(secs).padStart(2,'0');
  }
  tick();
  setInterval(tick, 1000);

  // testimony carousel
  const cards = document.querySelectorAll('.testi-card');
  const dotsWrap = document.getElementById('testiDots');
  cards.forEach((_,i)=>{
    const dot = document.createElement('span');
    if(i===0) dot.classList.add('active');
    dot.onclick = ()=> showTesti(i);
    dotsWrap.appendChild(dot);
  });
  let testiIdx = 0;
  function showTesti(i){
    cards[testiIdx].classList.remove('active');
    dotsWrap.children[testiIdx].classList.remove('active');
    testiIdx = i;
    cards[testiIdx].classList.add('active');
    dotsWrap.children[testiIdx].classList.add('active');
  }
  setInterval(()=>{ showTesti((testiIdx+1)%cards.length); }, 6000);

  // viewer count light animation
  const viewerEl = document.getElementById('viewerCount');
  let base = 8420;
  setInterval(()=>{
    base += Math.floor(Math.random()*9)-4;
    viewerEl.textContent = '👁 ' + base.toLocaleString() + ' watching';
  }, 3000);
</script>

