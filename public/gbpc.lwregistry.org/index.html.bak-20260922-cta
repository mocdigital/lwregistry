<!-- ===== HERO ===== -->
<section class="hero">
  <div class="dots" id="dots"></div>
  <div class="hero-inner">
    <div class="eyebrow"><span class="pulse-dot"></span> LIVE WORLDWIDE &nbsp;•&nbsp; ALL ZONES</div>
    <h1><span>Global Business</span><br/>Prayer Conference</h1>
