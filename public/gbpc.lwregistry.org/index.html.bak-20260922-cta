<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Global Business Prayer Conference | GBPC</title>
<style>
  :root{
    --navy:#0F0B3D;
    --navy2:#1B1464;
    --navy3:#241B7A;
    --gold:#C9A227;
    --gold-lt:#EFD98B;
    --cream:#FBF8F0;
    --ink:#23253A;
    --grey:#6B6F86;
    --line:#E7E1CE;
    --green:#2FA36B;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{font-family:Calibri,'Segoe UI',Arial,sans-serif;color:var(--ink);background:var(--cream);overflow-x:hidden;}
  h1,h2,h3,h4{font-family:Cambria,Georgia,serif;}
  a{text-decoration:none;color:inherit;}
  .container{max-width:1180px;margin:0 auto;padding:0 28px;}
  .eyebrow{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--gold);}

  /* reveal-on-scroll */
  .reveal{opacity:0;transform:translateY(22px);transition:opacity .7s ease, transform .7s ease;}
  .reveal.visible{opacity:1;transform:translateY(0);}

  /* ===== NAV ===== */
  .nav{
    position:fixed;top:0;left:0;right:0;z-index:100;
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 28px;background:rgba(15,11,61,0.72);backdrop-filter:blur(10px);
    border-bottom:1px solid rgba(201,162,39,0.18);
  }
  .nav .brand{display:flex;align-items:center;gap:10px;}
  .nav .brand img{width:36px;height:36px;border-radius:50%;box-shadow:0 0 0 2px var(--gold);}
  .nav .brand .bt{color:#fff;font-family:Cambria,serif;font-weight:700;font-size:15px;line-height:1.1;}
  .nav .brand .bt small{display:block;font-family:Calibri,sans-serif;font-size:8.5px;letter-spacing:1.5px;color:var(--gold-lt);font-weight:400;}
  .nav ul{display:flex;gap:26px;list-style:none;}
  .nav ul li a{color:#D9DAF2;font-size:12.5px;font-weight:600;letter-spacing:.3px;transition:color .2s;}
  .nav ul li a:hover{color:var(--gold-lt);}
  .nav .navcta{background:var(--gold);color:var(--navy);padding:9px 18px;border-radius:22px;font-size:12px;font-weight:700;letter-spacing:.3px;}
  .navToggle{display:none;color:#fff;font-size:22px;cursor:pointer;background:none;border:none;}
  @media (max-width:880px){
    .nav ul{display:none;}
    .navToggle{display:block;}
  }

  /* ===== HERO ===== */
  .hero{
    position:relative;min-height:100vh;display:flex;align-items:center;
    background-image:
      radial-gradient(circle at 50% 0%, rgba(42,33,150,0.88) 0%, rgba(27,20,100,0.92) 42%, rgba(15,11,61,0.95) 100%),
      url("data:image/png;base64,");
    background-size: cover, cover;
    background-position: center, center 30%;
    background-repeat: no-repeat, no-repeat;
    overflow:hidden;padding:120px 0 80px;
  }
  .hero::before{ /* rays */
    content:"";position:absolute;top:-20%;left:50%;transform:translateX(-50%);
    width:1400px;height:1400px;
    background:conic-gradient(from 0deg, rgba(201,162,39,0.09) 0deg 6deg, transparent 6deg 24deg);
    animation:spin 90s linear infinite;
  }
  @keyframes spin{ to{ transform:translateX(-50%) rotate(360deg); } }
  .hero::after{
    content:"";position:absolute;inset:0;
    background:radial-gradient(circle at 50% 30%, rgba(201,162,39,0.18) 0%, transparent 60%);
  }
  .dots{position:absolute;inset:0;pointer-events:none;}
  .dots span{position:absolute;width:4px;height:4px;border-radius:50%;background:var(--gold-lt);opacity:.55;}

  .hero-inner{position:relative;z-index:2;text-align:center;max-width:880px;margin:0 auto;padding:0 24px;}
  .hero .eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(201,162,39,0.14);border:1px solid rgba(201,162,39,0.4);padding:6px 16px;border-radius:20px;color:var(--gold-lt);margin-bottom:22px;}
  .hero .pulse-dot{width:7px;height:7px;border-radius:50%;background:#E4544B;box-shadow:0 0 0 rgba(228,84,75,.6);animation:pulse 1.6s infinite;}
  @keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(228,84,75,.6);}
    70%{box-shadow:0 0 0 9px rgba(228,84,75,0);}
    100%{box-shadow:0 0 0 0 rgba(228,84,75,0);}
  }
  .hero h1{font-size:52px;line-height:1.08;color:#fff;font-weight:700;margin-bottom:16px;}
  .hero h1 span{color:var(--gold-lt);}
  .hero .hero-subtitle{font-size:22px;color:var(--gold-lt);font-weight:600;max-width:640px;margin:-2px auto 18px;line-height:1.3;}
  .hero p.lead{font-size:16px;color:#C9CDEE;max-width:640px;margin:0 auto 14px;line-height:1.55;}
  .hero p.lead.lead-2{font-weight:600;color:#E4E7F7;margin-bottom:34px;}
  .hero-ctas{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:40px;}
  .btn{
    display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:30px;
    font-size:13.5px;font-weight:700;letter-spacing:.4px;cursor:pointer;border:none;transition:transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover{transform:translateY(-2px);}
  .btn-gold{background:var(--gold);color:var(--navy);box-shadow:0 8px 22px rgba(201,162,39,.35);}
  .btn-gold:hover{box-shadow:0 10px 26px rgba(201,162,39,.5);}
  .btn-outline{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.4);}
  .btn-outline:hover{border-color:#fff;}
  .btn-hero{
    padding:20px 52px;font-size:17px;border-radius:40px;
    background:linear-gradient(100deg,var(--gold-lt),var(--gold));color:var(--navy-deep);
    box-shadow:0 14px 34px rgba(201,162,39,.45), 0 0 0 6px rgba(201,162,39,.12);
    letter-spacing:.6px;
  }
  .btn-hero:hover{box-shadow:0 16px 40px rgba(201,162,39,.6), 0 0 0 8px rgba(201,162,39,.16);}

  .countdown{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}
  .cd-box{background:rgba(255,255,255,0.06);border:1px solid rgba(201,162,39,.3);border-radius:10px;padding:14px 18px;min-width:78px;text-align:center;}
  .cd-box .num{font-family:Cambria,serif;font-size:26px;font-weight:700;color:#fff;}
  .cd-box .lbl{font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold-lt);margin-top:3px;}

  .scrolldown{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);color:#C9CDEE;font-size:10px;letter-spacing:2px;text-transform:uppercase;z-index:2;}
  .scrolldown::after{content:"";display:block;width:1px;height:34px;background:linear-gradient(to bottom, var(--gold), transparent);margin:8px auto 0;}

  /* ===== STATS STRIP ===== */
  .stats{background:var(--navy3);padding:34px 0;}
  .stats .container{display:flex;justify-content:space-around;flex-wrap:wrap;gap:22px;text-align:center;}
  .stats .st .n{font-family:Cambria,serif;font-size:30px;font-weight:700;color:var(--gold-lt);}
  .stats .st .l{font-size:10.5px;letter-spacing:1.2px;text-transform:uppercase;color:#C9CDEE;margin-top:3px;}

  /* ===== SECTION GENERIC ===== */
  section{padding:88px 0;}
  .sec-head{text-align:center;max-width:640px;margin:0 auto 50px;}
  .sec-head h2{font-size:32px;color:var(--navy2);margin:10px 0 12px;}
  .sec-head p{font-size:14px;color:var(--grey);line-height:1.6;}

  /* ===== ABOUT ===== */
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;}
  .about-text p{font-size:14px;line-height:1.75;color:var(--ink);margin-bottom:14px;}
  .about-visual{
    aspect-ratio:4/3.3;border-radius:16px;position:relative;overflow:hidden;
    box-shadow:0 20px 50px rgba(15,11,61,.22);
  }
  .about-visual img{width:100%;height:100%;object-fit:cover;object-position:center 30%;display:block;}
  .about-visual .glabel{
    position:absolute;left:0;right:0;bottom:0;padding:14px 18px 12px;text-align:center;
    background:linear-gradient(to top, rgba(15,11,61,.85), transparent);
    color:#F3E9C8;font-family:Calibri,sans-serif;font-size:9.5px;letter-spacing:2px;text-transform:uppercase;
  }
  @media (max-width:860px){ .about-grid{grid-template-columns:1fr;} }

  /* ===== LIVE STREAM ===== */
  .live-section{background:var(--navy);}
  .live-section .sec-head p{color:#C9CDEE;}
  .live-section .sec-head h2{color:#fff;}
  .player-wrap{max-width:880px;margin:0 auto;}
  .player{
    position:relative;aspect-ratio:16/9;border-radius:14px;overflow:hidden;
    background:
      radial-gradient(circle at 30% 30%, rgba(201,162,39,.25), transparent 55%),
      linear-gradient(150deg,#1B1464 0%, #100C42 60%, #2A2196 140%);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 25px 60px rgba(0,0,0,.4);border:1px solid rgba(201,162,39,.25);
  }
  .player video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000;z-index:1;}
  /* `hidden` must win. Every rule below sets display, and an author display
     beats the UA stylesheet's [hidden]{display:none} — which is why the
     "Tap for sound" button never went away after it had been used. */
  .player [hidden]{display:none !important;}
  .player .unmute-btn{position:absolute;left:50%;bottom:64px;transform:translateX(-50%);z-index:5;background:var(--gold);color:var(--navy);border:none;border-radius:24px;padding:10px 20px;font-size:13px;font-weight:700;letter-spacing:.3px;cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.35);display:flex;align-items:center;gap:6px;}
  .player .unmute-btn:hover{filter:brightness(1.05);}
  .player .playbtn{
    width:78px;height:78px;border-radius:50%;background:rgba(255,255,255,0.12);
    border:1.5px solid rgba(255,255,255,.5);display:flex;align-items:center;justify-content:center;
    cursor:pointer;transition:transform .2s;
  }
  .player .playbtn:hover{transform:scale(1.08);background:rgba(255,255,255,0.2);}
  .player .playbtn .tri{width:0;height:0;border-top:14px solid transparent;border-bottom:14px solid transparent;border-left:22px solid #fff;margin-left:6px;}
  .live-badge{
    position:absolute;top:16px;left:16px;z-index:3;pointer-events:none;background:#E4544B;color:#fff;font-size:10.5px;font-weight:700;
    letter-spacing:1px;padding:5px 12px;border-radius:5px;display:flex;align-items:center;gap:6px;
  }
  .live-badge .dot{width:6px;height:6px;background:#fff;border-radius:50%;animation:pulse 1.4s infinite;}
  .viewers{
    position:absolute;top:16px;right:16px;z-index:3;pointer-events:none;background:rgba(0,0,0,.45);color:#fff;font-size:10.5px;
    padding:5px 12px;border-radius:5px;font-family:Calibri,sans-serif;
  }
  .player-cap{color:#C9CDEE;font-size:11px;margin-top:14px;text-align:center;}

  .schedule{max-width:880px;margin:36px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
  .sched-item{background:rgba(255,255,255,0.05);border:1px solid rgba(201,162,39,.22);border-radius:10px;padding:16px;}
  .sched-item .time{color:var(--gold-lt);font-size:11px;font-weight:700;letter-spacing:.5px;margin-bottom:6px;}
  .sched-item .ttl{color:#fff;font-size:13px;font-weight:700;margin-bottom:4px;}
  .sched-item .who{color:#9EA3D1;font-size:10.5px;}
  @media (max-width:760px){ .schedule{grid-template-columns:1fr;} }

  /* ===== REGISTRY CTA BAND ===== */
  .cta-band{
    background:linear-gradient(115deg,var(--gold) 0%, #DDB752 100%);
    padding:56px 0;
  }
  .cta-band .container{display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap;}
  .cta-band h3{font-size:26px;color:var(--navy);max-width:560px;line-height:1.3;}
  .cta-band p{font-size:12.5px;color:#4a3a10;margin-top:8px;max-width:520px;}
  .cta-band .btn-dark{background:var(--navy);color:#fff;}

  /* ===== TESTIMONIES ===== */
  .testi-wrap{max-width:820px;margin:0 auto;position:relative;}
  .testi-card{
    background:#fff;border:1px solid var(--line);border-radius:16px;padding:44px 46px;text-align:center;
    box-shadow:0 12px 34px rgba(27,20,100,.08);display:none;
  }
  .testi-card.active{display:block;animation:fadein .5s ease;}
  @keyframes fadein{ from{opacity:0;transform:translateY(8px);} to{opacity:1;transform:translateY(0);} }
  .testi-quote{font-family:Cambria,serif;font-size:19px;font-style:italic;color:var(--ink);line-height:1.55;margin-bottom:22px;}
  .testi-avatar{
    width:56px;height:56px;border-radius:50%;margin:0 auto 12px;
    background:linear-gradient(160deg,var(--navy2),var(--gold));
  }
  .testi-name{font-weight:700;color:var(--navy2);font-size:14px;}
  .testi-role{font-size:11.5px;color:var(--grey);margin-top:2px;}
  .testi-dots{display:flex;justify-content:center;gap:8px;margin-top:26px;}
  .testi-dots span{width:8px;height:8px;border-radius:50%;background:var(--line);cursor:pointer;transition:background .2s;}
  .testi-dots span.active{background:var(--gold);}

  /* ===== FOOTER ===== */
  footer{background:var(--navy);padding:46px 0 24px;color:#C9CDEE;}
  .foot-top{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:26px;padding-bottom:26px;border-bottom:1px solid rgba(201,162,39,.18);}
  .foot-brand{display:flex;gap:12px;align-items:center;max-width:340px;}
  .foot-brand img{width:44px;height:44px;border-radius:50%;box-shadow:0 0 0 2px var(--gold);}
  .foot-brand .fb-t{color:#fff;font-family:Cambria,serif;font-weight:700;font-size:15px;}
  .foot-brand .fb-s{font-size:10.5px;color:var(--gold-lt);margin-top:3px;line-height:1.4;}
  .foot-links{display:flex;gap:50px;flex-wrap:wrap;}
  .foot-links h5{color:#fff;font-size:11px;letter-spacing:1px;text-transform:uppercase;margin-bottom:12px;}
  .foot-links a{display:block;font-size:12px;color:#B7BBE6;margin-bottom:8px;}
  .foot-links a:hover{color:var(--gold-lt);}
  .foot-bottom{display:flex;justify-content:space-between;padding-top:18px;font-size:10.5px;color:#7C81B0;flex-wrap:wrap;gap:8px;}

  @media (max-width:600px){
    .hero h1{font-size:34px;}
    .cta-band .container{flex-direction:column;text-align:center;}
    .testi-card{padding:30px 22px;}
  }
</style>
</head>
<body>

<!-- ===== NAV ===== -->
<nav class="nav">
  <div class="brand">
    <img src="data:image/jpeg;base64," alt="Ministry of Commerce"/>
    <div class="bt">GBPC<small>GLOBAL BUSINESS PRAYER CONFERENCE</small></div>
