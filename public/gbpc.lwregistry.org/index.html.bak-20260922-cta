<script>
  (function(){
    var GBPC_ENDPOINT = 'https://lwregistry.org/gbpc/conference-registrations';
    var overlay = document.getElementById('gbpcRegModal');
    var form = document.getElementById('gbpcRegForm');
    var msg = document.getElementById('gbpcRegMsg');
    var btn = document.getElementById('gbpcSubmitBtn');

    window.gbpcOpenReg = function(){
      msg.className = 'gbpc-msg'; msg.textContent = '';
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
      var f = document.getElementById('gbpc-full-name'); if(f){ setTimeout(function(){ f.focus(); }, 60); }
    };
    window.gbpcCloseReg = function(){
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    };
    overlay.addEventListener('click', function(e){ if(e.target === overlay){ gbpcCloseReg(); } });
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && overlay.classList.contains('open')){ gbpcCloseReg(); } });

    // Reveal the business-name field only when they own a business.
    var ownsBusiness = document.getElementById('gbpc-owns-business');
    var businessNameField = document.getElementById('gbpc-business-name-field');
    ownsBusiness.addEventListener('change', function(){
      businessNameField.hidden = ownsBusiness.value !== 'Yes';
    });

    form.addEventListener('submit', function(e){
      e.preventDefault();
      msg.className = 'gbpc-msg'; msg.textContent = '';

      var payload = {
        title: form.title.value.trim(),
        full_name: form.full_name.value.trim(),
        phone: form.phone.value.trim(),
        kingschat_handle: form.kingschat_handle.value.trim(),
        email: form.email.value.trim(),
        country_city: form.country_city.value.trim(),
        zone: form.zone.value.trim(),
        occupation: form.occupation.value.trim(),
        owns_business: form.owns_business.value.trim(),
        business_name: form.business_name.value.trim(),
        expectations: form.expectations.value.trim()
      };

      var required = [payload.title, payload.full_name, payload.phone, payload.kingschat_handle,
        payload.email, payload.country_city, payload.zone, payload.occupation,
        payload.owns_business, payload.expectations];
      var missing = required.some(function(v){ return !v; });
      if(missing || (payload.owns_business === 'Yes' && !payload.business_name)){
        msg.className = 'gbpc-msg err';
        msg.textContent = 'Please fill in all required fields.';
        return;
      }

      btn.disabled = true;
      var original = btn.textContent;
      btn.textContent = 'Submitting…';

      fetch(GBPC_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      }).then(function(res){
        return res.json().catch(function(){ return {}; }).then(function(data){ return { ok: res.ok, status: res.status, data: data }; });
      }).then(function(r){
        if(r.ok){
          form.reset();
          msg.className = 'gbpc-msg ok';
          msg.textContent = (r.data && r.data.message) || 'Thank you! Your registration has been received.';
        } else if(r.status === 422){
          msg.className = 'gbpc-msg err';
          msg.textContent = 'Please check your details and try again.';
        } else {
          msg.className = 'gbpc-msg err';
          msg.textContent = 'Something went wrong. Please try again in a moment.';
        }
      }).catch(function(){
        msg.className = 'gbpc-msg err';
        msg.textContent = 'Network error. Please check your connection and try again.';
      }).finally(function(){
        btn.disabled = false;
        btn.textContent = original;
      });
    });
  })();
</script>

<!-- ===== LIVE STREAM (HLS) ===== -->
<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.17/dist/hls.min.js"></script>
<script>
  (function(){
    // The stream URL is admin-managed on lwregistry.org; fetch it so changing
    // it there updates what plays here with no re-upload. Falls back to the
    // built-in default if the endpoint cannot be reached.
    var STREAM_ENDPOINT = 'https://lwregistry.org/gbpc/stream-url';
    var DEFAULT_URL = 'https://vcpout-lw-wdc-01-sp.ceflixcdn.com/lxp/play2/playlist.m3u8';

    var video = document.getElementById('gbpcLive');
    var unmute = document.getElementById('gbpcUnmute');
    if (!video) return;

    // Browsers only allow autoplay when muted, so the stream starts muted and a
    // "Tap for sound" button (plus the native volume control) unmutes it. If
    // even muted autoplay is blocked, the native play button starts it.
    function tryPlay(){
      video.muted = true;
      var p = video.play();
      if (p && p.catch) { p.catch(function(){ /* the viewer uses the play control */ }); }
    }

    function turnSoundOn(){
      video.muted = false;
      if (video.volume === 0) video.volume = 1;
      video.play().catch(function(){});
      if (unmute) unmute.hidden = true;
    }

    if (unmute) {
      // Offer the unmute button once the stream is actually playing muted.
      video.addEventListener('playing', function(){
        unmute.hidden = !video.muted;
      });
      // Hide it if the viewer unmutes via the native controls instead.
      video.addEventListener('volumechange', function(){
        if (!video.muted && video.volume > 0) unmute.hidden = true;
      });
      unmute.addEventListener('click', turnSoundOn);
    }

    function play(url){
      if (!url) { return; }
      // Native HLS (Safari / iOS) plays the .m3u8 directly.
      if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = url;
        tryPlay();
        return;
      }
      // Everywhere else, hls.js.
      if (window.Hls && window.Hls.isSupported()) {
        var hls = new window.Hls({ enableWorker: true, lowLatencyMode: true });
        hls.loadSource(url);
        hls.attachMedia(video);
        hls.on(window.Hls.Events.MANIFEST_PARSED, function(){
          tryPlay();
        });
        hls.on(window.Hls.Events.ERROR, function(e, data){
          if (!data || !data.fatal) return;
          // Recover rather than give up: a live stream drops segments, and a
          // network blip should not end the broadcast for the viewer.
          if (data.type === window.Hls.ErrorTypes.NETWORK_ERROR) { hls.startLoad(); }
          else if (data.type === window.Hls.ErrorTypes.MEDIA_ERROR) { hls.recoverMediaError(); }
          else { hls.destroy(); }
        });
        return;
      }
      // No HLS support at all — offer the raw URL to the browser as a last try.
      video.src = url;
    }

    fetch(STREAM_ENDPOINT, { headers: { 'Accept': 'application/json' } })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(data){ play((data && data.url) ? data.url : DEFAULT_URL); })
      .catch(function(){ play(DEFAULT_URL); });
  })();
</script>

